---
const sections = [
  { href: '#top', number: '00', label: 'Home' },
  { href: '#about', number: '01', label: 'About' },
  { href: '#papers', number: '02', label: 'Publications' },
  { href: '#talks', number: '03', label: 'Talks' },
  { href: '#seminars', number: '04', label: 'Seminars' },
  { href: '#links', number: '05', label: 'Elsewhere' },
];
---

<button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-controls="site-sidebar" aria-expanded="false" aria-label="Open navigation">
  <span class="toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
  <span>Menu</span>
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

<aside class="site-sidebar" id="site-sidebar" aria-label="Section navigation">
  <div class="sidebar-brand">
    <span class="brand-kicker">ACADEMIC WEBSITE</span>
    <a class="brand-name" href="#top">Shunsuke<br />Yasunaga</a>
    <span class="brand-subtitle">Hadron physics<br />&amp; lattice QCD</span>
  </div>

  <nav class="sidebar-nav" aria-label="On this page">
    <span class="nav-caption">EXPLORE</span>
    {sections.map(({ href, number, label }) => (
      <a href={href} class="sidebar-link">
        <span class="nav-number" aria-hidden="true">{number}</span>
        <span>{label}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-foot">
    <span class="foot-line"></span>
    Institute of Science Tokyo
  </div>
</aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#sidebar-toggle');
  const backdrop = document.querySelector<HTMLElement>('#sidebar-backdrop');
  const sidebar = document.querySelector<HTMLElement>('#site-sidebar');
  const links = document.querySelectorAll<HTMLAnchorElement>('.sidebar-link, .brand-name');
  const mobile = window.matchMedia('(max-width: 900px)');

  function setMenuOpen(open: boolean) {
    const isOpen = open && mobile.matches;
    document.body.classList.toggle('sidebar-open', isOpen);
    toggle?.setAttribute('aria-expanded', String(isOpen));
    toggle?.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
    sidebar?.toggleAttribute('inert', mobile.matches && !isOpen);
  }

  toggle?.addEventListener('click', () => {
    const opening = !document.body.classList.contains('sidebar-open');
    setMenuOpen(opening);
    if (opening) sidebar?.querySelector<HTMLAnchorElement>('a')?.focus();
  });
  backdrop?.addEventListener('click', () => setMenuOpen(false));
  links.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && document.body.classList.contains('sidebar-open')) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });
  mobile.addEventListener('change', () => setMenuOpen(false));
  setMenuOpen(false);
</script>

<style>
  .site-sidebar{position:fixed;inset:0 auto 0 0;width:244px;z-index:30;display:flex;flex-direction:column;overflow-y:auto;padding:40px 28px 25px;background:#123323;color:#f0f5ee;border-right:1px solid #ffffff18;box-shadow:7px 0 25px #0a211410}
  .sidebar-brand{display:flex;flex-direction:column;align-items:flex-start}.brand-kicker,.nav-caption{font-size:10px;font-weight:700;letter-spacing:.17em;color:#c8a0ad}.brand-name{display:block;margin:23px 0 13px;color:#fff;font:400 31px/1.02 Georgia,serif;letter-spacing:-.035em;text-decoration:none}.brand-name:hover{color:#eec5d0}.brand-subtitle{font:italic 13px/1.5 Georgia,serif;color:#bdd1c4}
  .sidebar-nav{display:flex;flex-direction:column;gap:2px;margin-top:60px}.nav-caption{margin-bottom:16px}.sidebar-link{display:flex;align-items:baseline;gap:16px;padding:12px 5px;border-bottom:1px solid #ffffff1b;color:#e4efe7;font-size:14px;text-decoration:none;transition:color .2s,transform .2s}.sidebar-link:hover,.sidebar-link:focus-visible{color:#f3bdcb;transform:translateX(3px)}.nav-number{font-size:10px;letter-spacing:.08em;color:#86b199;font-weight:700}
  .sidebar-foot{margin-top:auto;padding-top:35px;font-size:11px;line-height:1.5;color:#aec5b6}.foot-line{display:block;width:35px;height:2px;background:#be718e;margin-bottom:14px}
  .sidebar-toggle,.sidebar-backdrop{display:none}
  @media(max-width:900px){
    .site-sidebar{width:min(290px,85vw);transform:translateX(-104%);transition:transform .25s ease;z-index:60;padding-top:70px;box-shadow:8px 0 35px #0a211440}
    .sidebar-toggle{position:fixed;left:16px;top:16px;z-index:70;display:flex;align-items:center;gap:10px;border:1px solid #ffffff44;border-radius:999px;background:#123323;color:white;padding:11px 15px;box-shadow:0 3px 18px #0d2a1c50;font-size:12px;letter-spacing:.05em;cursor:pointer}
    .toggle-bars{display:flex;flex-direction:column;gap:3px}.toggle-bars span{display:block;width:16px;height:1.5px;background:currentColor}
    .sidebar-backdrop{position:fixed;inset:0;z-index:50;background:#08180fb0}
    :global(body.sidebar-open){overflow:hidden}
    :global(body.sidebar-open) .site-sidebar{transform:translateX(0)}
    :global(body.sidebar-open) .sidebar-backdrop{display:block}
    .brand-name{margin-top:18px}.sidebar-nav{margin-top:34px}
  }
  @media(prefers-reduced-motion:reduce){.site-sidebar,.sidebar-link{transition:none}}
</style>
