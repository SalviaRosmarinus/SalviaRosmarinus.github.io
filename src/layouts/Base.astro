---
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7f3" />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
    <style is:global>
      :root { --accent: #267f52; --accent-dark: #195b3a; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #242a28; background: #f5f7f3; scroll-behavior: smooth; }
      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; }
      a { color: var(--accent); text-underline-offset: 4px; }
      a:hover { color: var(--accent-dark); }
      a:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 3px; }
      .shell { max-width: 1150px; padding: 0 36px; margin: auto; }
      .skip { position: absolute; left: -9999px; top: 10px; z-index: 20; background: white; padding: 10px; }
      .skip:focus { left: 10px; }
      @media (max-width: 650px) { .shell { padding: 0 20px; } }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
