---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { publications } from '../data/publications';
import { talks } from '../data/talks';
import { seminars } from '../data/seminars';
---
<Base title="Shunsuke Yasunaga | Website" description="Website of Shunsuke Yasunaga, a researcher in physics.">
  <Sidebar />
  <div class="page-content">
  <header class="mast" id="top">
    <div class="mast-shade"></div>
    <div class="shell mast-inner">
      <div class="topline">
        <span class="topline-mark">SHUNSUKE YASUNAGA · RESEARCH WEBSITE</span>
      </div>
      <div class="mast-title"><span class="overline">PHYSICS · TOKYO</span><h1>Research notes<br /><span>&amp; other paths</span></h1></div>
      <div class="mast-bottom"><span>Institute of Science Tokyo</span><a href="#contents">Enter the page ↓</a></div>
    </div>
  </header>

  <main id="main" class="field">
    <div class="shell">
      <div class="index-panel" id="contents">
        <div class="index-grid">
          <section id="about" class="column"><h2><span aria-hidden="true">✎</span> About</h2><p>I am a doctoral researcher in physics at the Institute of Science Tokyo. I work with scattering amplitudes and numerical approaches to the strong interaction.</p><p>My interests move between reactions, field theory, and computation; these are different ways of asking what a calculation can tell us about particles.</p><a href="https://orcid.org/0009-0004-7788-0074">ORCID ↗</a><br /><a href="https://inspirehep.net/authors/2789921">INSPIRE profile ↗</a></section>
          <section id="links" class="column links-column" aria-label="Research links"><ul class="elsewhere"><li><a href="#papers">Publications</a></li><li><a href="https://inspirehep.net/authors/2789921">INSPIRE-HEP</a></li><li><a href="https://orcid.org/0009-0004-7788-0074">ORCID</a></li><li><a href="https://github.com/SalviaRosmarinus">Code on GitHub</a></li></ul><p class="side-note">A small map of current work, rather than a comprehensive account.</p></section>
        </div>
      </div>

      <section class="papers-panel" id="papers"><div class="papers-head"><div><h2>Publications</h2></div></div><div class="paper-list">{publications.map((paper) => <article class="paper"><span class="year">{paper.year}</span><div><h3>{paper.title}</h3><p>{paper.authors}</p><small><a class="venue-link" href={paper.url}>arXiv:{paper.url.split('/').pop()}</a>{paper.doi ? <> · <a class="venue-link" href={paper.doi}>{paper.venue}</a></> : null}{paper.status ? ` · ${paper.status}` : ''}</small></div></article>)}</div></section>
      <section class="talks-panel" id="talks"><div class="papers-head"><div><h2>Talks</h2></div></div><div class="talk-list">{talks.map((talk) => <article class="talk"><time class="year" datetime={talk.date}>{talk.date.slice(0, 7).replace("-", ".")}</time><div><h3>{talk.title}</h3>{/* <p>{talk.authors}</p> */}<p class="talk-event">{talk.eventUrl ? <a href={talk.eventUrl}>{talk.event}</a> : talk.event}{/* {talk.session ? ` · ${talk.session}` : ''} */} · {talk.location}</p></div></article>)}</div></section>
      <section class="seminars-panel" id="seminars">
        <div class="papers-head"><div><h2>Seminars</h2></div></div>
        {seminars.length > 0 ? (
          <div class="talk-list">{seminars.map((seminar) => (
            <article class="talk">
              <time class="year" datetime={seminar.date}>{seminar.date.slice(0, 7).replace('-', '.')}</time>
              <div>
                <h3>{seminar.title}</h3>
                <p class="talk-event">{seminar.url ? <a href={seminar.url}>{seminar.series}</a> : seminar.series}{seminar.location ? ` · ${seminar.location}` : ''}</p>
              </div>
            </article>
          ))}</div>
        ) : <p class="seminar-empty">Seminar details will be added here.</p>}
      </section>
      <section class="note-panel" id="note">
        <div class="papers-head"><div><h2>Note</h2></div></div>
        <p class="note-empty">Notes will be added here.</p>
      </section>
    </div>
  </main>
  <footer><div class="shell"><span>Shunsuke Yasunaga · {new Date().getFullYear()}</span><a href="#top">Back to top ↑</a></div></footer>
  </div>
</Base>

<style>
  .page-content{margin-left:244px;min-width:0}
  .mast{position:relative;min-height:610px;background:#10251a url('/sunset-original.webp') center 42%/cover no-repeat;color:#fff;overflow:hidden}
  .mast-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,25,16,.58) 0%,rgba(10,35,20,.08) 58%,rgba(7,24,15,.16)),linear-gradient(0deg,rgba(7,24,15,.24),transparent 38%)}
  .mast-inner{position:relative;min-height:610px;display:flex;flex-direction:column}.topline{display:flex;justify-content:flex-end;align-items:center;padding:26px 0;border-bottom:1px solid #ffffff5c}.topline-mark{font-size:10px;letter-spacing:.14em;color:#f7f0ed}.mast-bottom a{color:#fff;text-decoration:none;font-size:13px}.mast-bottom a:hover{text-decoration:underline;text-decoration-color:#ffb9c4}
  .mast-title{position:relative;z-index:2;margin:107px 0 85px 11%;max-width:500px}.overline,.year{font-size:11px;letter-spacing:.13em;text-transform:uppercase;font-weight:700}.mast-title .overline{color:#f5b7cc}.mast h1{font:400 clamp(48px,6vw,82px)/1.02 Georgia,serif;letter-spacing:-.052em;margin:17px 0}.mast h1 span{font-style:italic;color:#e5f5eb}.mast-bottom{margin-top:auto;display:flex;justify-content:space-between;padding:19px 0;border-top:1px solid #ffffff66;color:#e5ece6;font-size:12px}
  .field{padding:0 0 100px;background:#f5f7f3}.index-panel{position:relative;padding:26px 32px 38px;background:#fffffff0;box-shadow:0 16px 36px #1239252a;border-top:5px solid var(--accent)}.index-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:35px;padding-top:8px}.column{min-width:0}.column + .column{border-left:1px solid #c9d9ce;padding-left:35px}.links-column{padding-top:56px}.column h2{font:700 clamp(23px,2.3vw,30px)/1.15 Georgia,serif;color:var(--accent-dark);margin:0 0 25px}.column h2 span{font:normal 20px system-ui;color:#9d3859;margin-right:5px}.column p{font-size:15px;line-height:1.7;color:#25332a;margin:0 0 16px}.column a,.paper a{color:var(--accent);text-decoration:none}.column a:hover,.paper a:hover{text-decoration:underline}.elsewhere{list-style:none;padding:0;margin:0}.elsewhere li{margin-bottom:14px}.elsewhere a{font:20px Georgia,serif}.column .side-note{font:italic 13px/1.5 Georgia,serif;color:#596c60;margin-top:28px}
  .papers-panel{background:#fffffff0;padding:35px 32px 55px}.papers-head{display:flex;justify-content:space-between;gap:25px;align-items:end;border-bottom:2px solid var(--accent);padding-bottom:18px}.papers-head h2{font:400 clamp(30px,3.5vw,44px) Georgia,serif;color:#22382a;margin:0}.paper{display:grid;grid-template-columns:68px 1fr;gap:15px;padding:18px 0;border-bottom:1px solid #d9e5dc}.year{color:#9a4665;padding-top:4px}.paper h3{font:400 19px/1.3 Georgia,serif;margin:0 0 5px}.paper p{font-size:12px;color:#455c4c;margin:0 0 5px;line-height:1.5}.paper small{color:#596c60;font-size:11px}.paper .venue-link{color:inherit}
  .talks-panel,.seminars-panel,.note-panel{background:#fffffff0;padding:35px 32px 55px;border-top:1px solid #d9e5dc}.talk-list{width:100%}.talk{display:grid;grid-template-columns:68px minmax(0,1fr);gap:15px;width:100%;padding:17px 0;border-bottom:1px solid #d9e5dc}.talk h3{font:400 18px/1.35 Georgia,serif;color:#22382a;margin:0 0 6px}.talk p{font-size:12px;color:#455c4c;line-height:1.5;margin:0 0 4px}.talk .talk-event{color:#596c60}.talk-event a{color:var(--accent);text-decoration:none}.talk-event a:hover{text-decoration:underline}.seminar-empty,.note-empty{font:italic 15px/1.5 Georgia,serif;color:#718175;margin:27px 0 0}footer{background:#183b29;color:#dbe9dd;font-size:12px}footer .shell{display:flex;justify-content:space-between;gap:20px;padding-top:24px;padding-bottom:24px}footer a{color:#d2efd8;text-decoration:none}
  @media(max-width:900px){.page-content{margin-left:0}.mast-title{margin-left:5%}.index-grid{gap:23px}.column + .column{padding-left:23px}.elsewhere a{font-size:18px}.topline-mark{margin-left:76px}}
  @media(max-width:700px){.mast,.mast-inner{min-height:570px}.topline{align-items:flex-start;flex-wrap:wrap}.topline-mark{display:none}.mast-title{margin:115px 0 95px 0}.mast h1{font-size:clamp(47px,12vw,66px)}.index-panel{padding:23px 23px 34px}.index-grid{display:block}.column + .column{padding:26px 0 0;border-left:0;border-top:1px solid #c9d9ce;margin-top:26px}.column h2{margin-bottom:16px}.papers-panel,.talks-panel,.seminars-panel,.note-panel{padding:29px 23px 43px}.papers-head{display:block}.paper{grid-template-columns:50px 1fr;gap:8px}.paper h3{font-size:17px}.talk{grid-template-columns:50px minmax(0,1fr);gap:8px}.talk h3{font-size:17px}}
</style>
