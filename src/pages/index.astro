---
import Base from '../layouts/Base.astro';
import { publications } from '../data/publications';
const selected = publications.slice(0, 3);
---
<Base title="Shunsuke Yasunaga — Theoretical Physics" description="Shunsuke Yasunaga studies hadron and nuclear physics, lattice QCD, and computational methods.">
  <header class="masthead">
    <div class="shell nav">
      <a class="wordmark" href="#top">SY<span class="wordmark-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a><a href="#research">Research</a><a href="#publications">Publications</a><a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero shell" id="top" aria-labelledby="intro-title">
      <div class="hero-copy">
        <span class="eyebrow">THEORETICAL &amp; COMPUTATIONAL PHYSICS</span>
        <h1 id="intro-title">Shunsuke<br /><em>Yasunaga</em><span class="period">.</span></h1>
        <p class="hero-lede">Exploring the strong interaction from hadron reactions to lattice QCD.</p>
        <div class="hero-links"><a class="button" href="#research">Explore research <span aria-hidden="true">↗</span></a><a class="text-link" href="#publications">Selected work <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="research-mark" aria-hidden="true"><div class="orbit orbit-1"></div><div class="orbit orbit-2"></div><div class="orbit orbit-3"></div><div class="core"></div><span class="particle p1"></span><span class="particle p2"></span><span class="particle p3"></span><span class="particle p4"></span></div>
      <div class="hero-footer"><span>Institute of Science Tokyo</span><span>NUCLEAR THEORY · LATTICE QCD</span></div>
    </section>

    <section class="section about" id="about"><div class="shell section-grid"><div class="section-label"><span class="number">01 /</span> About</div><div><h2>Two perspectives on the <em>strong force.</em></h2><p>I am a doctoral researcher in theoretical physics at the Institute of Science Tokyo. My work connects hadron and nuclear reactions, particularly hyperon–nucleon interactions, with computational approaches to quantum chromodynamics.</p><p>I use scattering amplitudes and reaction models to study how hadrons interact, and explore numerical methods for lattice fermions and chiral symmetry.</p></div></div></section>

    <section class="section research" id="research"><div class="shell"><div class="section-grid heading-row"><div class="section-label"><span class="number">02 /</span> Research</div><h2>Questions that connect<br /><em>theory and computation.</em></h2></div><div class="research-grid"><article class="research-card"><span class="card-no">01</span><div class="symbol">ΛN <span>↔</span> ΣN</div><h3>Hadron &amp; nuclear physics</h3><p>Hyperon–nucleon interactions and coupled-channel dynamics through kaon-induced deuteron reactions. Near-threshold structures offer a way to constrain low-energy scattering amplitudes.</p><a href="https://arxiv.org/abs/2610.15928">Read recent work <span aria-hidden="true">↗</span></a></article><article class="research-card"><span class="card-no">02</span><div class="symbol">D<sub>5</sub> <span>→</span> D<sub>4</sub></div><h3>Lattice QCD &amp; algorithms</h3><p>Domain-wall fermions, chiral symmetry, and machine-learning-based optimization of parameters in lattice calculations. I am interested in practical methods that improve numerical efficiency.</p><a href="https://arxiv.org/abs/2603.16329">Read recent work <span aria-hidden="true">↗</span></a></article></div></div></section>

    <section class="section publications" id="publications"><div class="shell"><div class="section-grid heading-row"><div class="section-label"><span class="number">03 /</span> Publications</div><div><h2>Selected <em>work.</em></h2><p>Research papers and preprints. The full list follows below.</p></div></div><div class="papers featured">{selected.map((paper) => <article class="paper"><div class="paper-meta"><span>{paper.year}</span><span>{paper.area}</span></div><div class="paper-body"><h3><a href={paper.url}>{paper.title} <span aria-hidden="true">↗</span></a></h3><p>{paper.authors}</p><span class="venue">{paper.venue}{paper.status ? ` · ${paper.status}` : ''}</span></div></article>)}</div><details class="more"><summary>View all publications <span aria-hidden="true">＋</span></summary><div class="papers">{publications.slice(3).map((paper) => <article class="paper"><div class="paper-meta"><span>{paper.year}</span><span>{paper.area}</span></div><div class="paper-body"><h3><a href={paper.url}>{paper.title} <span aria-hidden="true">↗</span></a></h3><p>{paper.authors}</p><span class="venue">{paper.venue}{paper.status ? ` · ${paper.status}` : ''}</span>{paper.doi && <a class="doi" href={paper.doi}>Journal ↗</a>}</div></article>)}</div></details></div></section>

    <section class="section contact" id="contact"><div class="shell section-grid"><div class="section-label"><span class="number">04 /</span> Contact</div><div><h2>Find my <em>work.</em></h2><p>Research profiles, publications, and code.</p><div class="profile-links"><a href="https://inspirehep.net/authors/2789921">INSPIRE-HEP ↗</a><a href="https://orcid.org/0009-0004-7788-0074">ORCID ↗</a><a href="https://github.com/SalviaRosmarinus">GitHub ↗</a></div></div></div></section>
  </main>
  <footer class="footer"><div class="shell"><span>© {new Date().getFullYear()} Shunsuke Yasunaga</span><a href="#top">Back to top ↑</a></div></footer>
</Base>

<style>
  .masthead{border-bottom:1px solid #deddd5;background:#f7f5ef}.nav{height:79px;display:flex;align-items:center;justify-content:space-between}.wordmark{font-family:Georgia,serif;font-size:28px;font-weight:bold;color:#202b2c;text-decoration:none;letter-spacing:-.07em}.wordmark-dot,.period{color:#c87546}nav{display:flex;gap:32px}nav a{text-decoration:none;color:#4b5552;font-size:13px;font-weight:600}nav a:hover{color:#b45c34}.hero{min-height:680px;padding-top:122px;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between}.hero-copy{position:relative;z-index:2}.eyebrow,.section-label,.hero-footer,.card-no,.paper-meta,.venue{font-size:11px;letter-spacing:.13em;text-transform:uppercase;font-weight:700}.eyebrow{color:#9b603d}.hero h1{font-family:Georgia,Times,serif;font-weight:400;font-size:clamp(70px,10vw,134px);line-height:.91;letter-spacing:-.075em;margin:27px 0 23px}.hero em,.section em{font-weight:400;color:#386e6d}.hero-lede{font-size:20px;line-height:1.55;max-width:530px;color:#4c5652}.hero-links{display:flex;align-items:center;gap:29px;margin-top:38px}.button{display:inline-flex;gap:38px;background:#244e51;color:#fff;text-decoration:none;padding:16px 20px;font-size:13px;font-weight:700;border-radius:2px}.button:hover{background:#163c3e;color:#fff}.text-link{text-decoration:none;color:#244e51;font-size:13px;font-weight:700}.hero-footer{display:flex;justify-content:space-between;border-top:1px solid #dadbd3;padding:26px 0;color:#65716e}.research-mark{position:absolute;right:70px;top:75px;width:480px;height:480px;opacity:.72}.orbit{position:absolute;border:1px solid #9bb0a9;border-radius:50%;inset:10%;transform:rotate(-27deg) scaleY(.58)}.orbit-2{transform:rotate(44deg) scaleY(.68);inset:5%}.orbit-3{transform:rotate(112deg) scaleY(.46);inset:14%}.core{position:absolute;background:#b87953;width:80px;height:80px;left:calc(50% - 40px);top:calc(50% - 40px);border-radius:50%;box-shadow:0 0 90px #bc866a44}.particle{position:absolute;border-radius:50%;height:11px;width:11px;background:#316668}.p1{top:14%;left:21%}.p2{top:75%;left:70%}.p3{top:27%;left:85%}.p4{top:79%;left:26%;background:#c7744e}.section{padding:114px 0}.section-grid{display:grid;grid-template-columns:240px 1fr;gap:42px}.section-label{color:#6e7a75;padding-top:13px}.number{color:#ba764e;margin-right:8px}.section h2{font:400 clamp(39px,4.3vw,59px)/1.12 Georgia,serif;letter-spacing:-.046em;margin:0 0 28px;max-width:750px}.section p{font-size:17px;line-height:1.75;color:#52615b;max-width:705px}.about{background:#e9eee8}.about p{max-width:670px}.research{background:#f7f5ef}.heading-row{margin-bottom:48px}.research-grid{margin-left:282px;display:grid;grid-template-columns:1fr 1fr;gap:16px}.research-card{min-height:410px;border:1px solid #d4d8d0;padding:28px;display:flex;flex-direction:column;background:#faf9f5}.card-no{color:#ac704f}.symbol{font:32px Georgia,serif;color:#3c6969;margin:56px 0 24px}.symbol span{color:#ba805c}.research-card h3{font:400 27px/1.2 Georgia,serif;margin:0 0 4px}.research-card p{font-size:14px;line-height:1.65;margin-bottom:28px}.research-card a{margin-top:auto;text-decoration:none;font-size:13px;font-weight:700}.publications{background:#fffefa}.publications .heading-row p{margin-top:-12px;font-size:15px}.papers{margin-left:282px}.paper{display:grid;grid-template-columns:155px 1fr;gap:20px;padding:26px 0;border-top:1px solid #dbded9}.paper-meta{display:flex;flex-direction:column;gap:9px;color:#71807a}.paper-meta span:first-child{color:#b5704a}.paper h3{font:400 22px/1.28 Georgia,serif;margin:0 0 11px;letter-spacing:-.014em}.paper h3 a{text-decoration:none;color:#263d3e}.paper h3 a:hover{color:#2b6b70}.paper h3 a span{color:#b67650;font:15px system-ui;white-space:nowrap}.paper p{font-size:13px;line-height:1.5;margin:0 0 8px}.venue{color:#828a82;font-size:10px;letter-spacing:.065em}.doi{margin-left:12px;font-size:12px}.more{margin:10px 0 0 282px;border-top:1px solid #dbded9}.more summary{cursor:pointer;list-style:none;font-size:13px;font-weight:700;color:#245f68;padding:25px 0;display:flex;justify-content:space-between}.more summary::-webkit-details-marker{display:none}.more .papers{margin-left:0}.contact{background:#244e51;color:#fff}.contact .section-label{color:#b9d1c9}.contact h2 em{color:#b6cfbd}.contact p{color:#d1e1da}.profile-links{display:flex;gap:20px;flex-wrap:wrap;margin-top:32px}.profile-links a{color:#f6f2e9;text-decoration:none;border:1px solid #81a4a0;padding:14px 19px;font-size:13px;font-weight:700}.profile-links a:hover{background:#fff;color:#244e51}.footer{background:#1b3b3d;color:#c8d6ce;font-size:12px}.footer .shell{display:flex;justify-content:space-between;padding-top:30px;padding-bottom:30px}.footer a{color:#c8d6ce;text-decoration:none}@media(max-width:900px){.research-mark{right:-180px;opacity:.27}.section-grid{grid-template-columns:150px 1fr;gap:25px}.research-grid,.papers{margin-left:175px}.more{margin-left:175px}.research-grid{grid-template-columns:1fr}.research-card{min-height:300px}.symbol{margin:20px 0 14px}}@media(max-width:650px){.nav{height:auto;padding-top:19px;padding-bottom:19px;align-items:flex-start;gap:15px;flex-wrap:wrap}nav{gap:16px;flex-wrap:wrap}nav a{font-size:12px}.hero{min-height:560px;padding-top:80px}.hero h1{font-size:clamp(62px,14vw,90px)}.hero-lede{font-size:17px}.research-mark{width:330px;height:330px;right:-140px;top:180px;opacity:.2}.hero-footer{font-size:9px;gap:15px}.section{padding:72px 0}.section-grid{display:block}.section-label{margin-bottom:22px}.research-grid,.papers,.more{margin-left:0}.research-card{padding:23px}.paper{grid-template-columns:1fr;gap:8px}.paper-meta{flex-direction:row;gap:16px}.hero-links{flex-wrap:wrap}.footer .shell{gap:15px}}
</style>
