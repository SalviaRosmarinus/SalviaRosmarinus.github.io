---
import Base from '../layouts/Base.astro';
import { publications } from '../data/publications';
import { talks } from '../data/talks';
---
<Base title="Shunsuke Yasunaga | Website" description="Website of Shunsuke Yasunaga, a researcher in physics.">
  <header class="mast" id="top">
    <div class="mast-shade"></div>
    <div class="shell mast-inner">
      <div class="topline">
        <nav aria-label="Main navigation"><a href="#about">About</a><a href="#papers">Papers</a><a href="#talks">Talks</a><a href="#links">Links</a></nav>
      </div>
      <div class="mast-title"><span class="overline">PHYSICS · TOKYO</span><h1>Research notes<br /><span>&amp; other paths</span></h1></div>
      <div class="mast-bottom"><span>Institute of Science Tokyo</span><a href="#contents">Enter the page ↓</a></div>
    </div>
  </header>

  <main id="main" class="field">
    <div class="shell">
      <div class="index-panel" id="contents">
        <div class="panel-top"><span>INDEX / 01</span><span>Follow whichever thread looks interesting.</span></div>
        <div class="index-grid">
          <section id="about" class="column"><h2><span aria-hidden="true">✎</span> About</h2><p>I am a doctoral researcher in physics at the Institute of Science Tokyo. I work with scattering amplitudes and numerical approaches to the strong interaction.</p><p>My interests move between reactions, field theory, and computation; these are different ways of asking what a calculation can tell us about particles.</p><a href="https://orcid.org/0009-0004-7788-0074">ORCID ↗</a><br /><a href="https://inspirehep.net/authors/2789921">INSPIRE profile ↗</a></section>
          <section id="links" class="column"><h2><span aria-hidden="true">↗</span> Elsewhere</h2><ul class="elsewhere"><li><a href="#papers">Papers &amp; preprints</a></li><li><a href="https://inspirehep.net/authors/2789921">INSPIRE-HEP</a></li><li><a href="https://orcid.org/0009-0004-7788-0074">ORCID</a></li><li><a href="https://github.com/SalviaRosmarinus">Code on GitHub</a></li></ul><p class="side-note">A small map of current work, rather than a comprehensive account.</p></section>
        </div>
      </div>

      <section class="papers-panel" id="papers"><div class="papers-head"><div><span class="overline">INDEX / 02</span><h2>Papers &amp; preprints</h2></div></div><div class="paper-list">{publications.map((paper) => <article class="paper"><span class="year">{paper.year}</span><div><h3>{paper.title}</h3><p>{paper.authors}</p><small><a class="venue-link" href={paper.url}>arXiv:{paper.url.split('/').pop()}</a> · {paper.doi ? <a class="venue-link" href={paper.doi}>{paper.venue}</a> : <a class="venue-link" href={paper.url.replace('/abs/', '/pdf/')}>Paper (PDF)</a>}{paper.status ? ` · ${paper.status}` : ''}</small></div></article>)}</div></section>
      <section class="talks-panel" id="talks"><div class="papers-head"><div><span class="overline">INDEX / 03</span><h2>Talks</h2></div></div><div class="talk-list">{talks.map((talk) => <article class="talk"><time class="year" datetime={talk.date}>{talk.month}</time><div><h3>{talk.title}</h3><p>{talk.authors}</p><p class="talk-event">{talk.eventUrl ? <a href={talk.eventUrl}>{talk.event}</a> : talk.event}{talk.session ? ` · ${talk.session}` : ''} · {talk.location}</p></div></article>)}</div></section>
    </div>
  </main>
  <footer><div class="shell"><span>Shunsuke Yasunaga · {new Date().getFullYear()}</span><a href="#top">Back to top ↑</a></div></footer>
</Base>

<style>
  .mast{position:relative;min-height:610px;background:#10251a url('/sunset-original.webp') center 42%/cover no-repeat;color:#fff;overflow:hidden}
  .mast-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,25,16,.58) 0%,rgba(10,35,20,.08) 58%,rgba(7,24,15,.16)),linear-gradient(0deg,rgba(7,24,15,.24),transparent 38%)}
  .mast-inner{position:relative;min-height:610px;display:flex;flex-direction:column}.topline{display:flex;justify-content:flex-end;align-items:center;padding:26px 0;border-bottom:1px solid #ffffff5c}.topline nav{display:flex;gap:25px}.topline nav a,.mast-bottom a{color:#fff;text-decoration:none;font-size:13px}.topline a:hover,.mast-bottom a:hover{text-decoration:underline;text-decoration-color:#ffb9c4}
  .mast-title{position:relative;z-index:2;margin:107px 0 85px 11%;max-width:500px}.overline,.panel-top,.year{font-size:11px;letter-spacing:.13em;text-transform:uppercase;font-weight:700}.mast-title .overline{color:#f5b7cc}.mast h1{font:400 clamp(48px,6vw,82px)/1.02 Georgia,serif;letter-spacing:-.052em;margin:17px 0}.mast h1 span{font-style:italic;color:#e5f5eb}.mast-bottom{margin-top:auto;display:flex;justify-content:space-between;padding:19px 0;border-top:1px solid #ffffff66;color:#e5ece6;font-size:12px}
  .field{padding:0 0 100px;background:#f5f7f3}.index-panel{position:relative;padding:26px 32px 38px;background:#fffffff0;box-shadow:0 16px 36px #1239252a;border-top:5px solid var(--accent)}.panel-top{display:flex;justify-content:space-between;gap:20px;color:#52685a;border-bottom:1px solid #c4d7c8;padding:0 0 17px}.panel-top span:last-child{font-weight:400;letter-spacing:0;text-transform:none}.index-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:35px;padding-top:27px}.column{min-width:0}.column + .column{border-left:1px solid #c9d9ce;padding-left:35px}.column h2{font:700 clamp(23px,2.3vw,30px)/1.15 Georgia,serif;color:var(--accent-dark);margin:0 0 25px}.column h2 span{font:normal 20px system-ui;color:#9d3859;margin-right:5px}.column p{font-size:15px;line-height:1.7;color:#25332a;margin:0 0 16px}.column a,.paper a{color:var(--accent);text-decoration:none}.column a:hover,.paper a:hover{text-decoration:underline}.elsewhere{list-style:none;padding:0;margin:0}.elsewhere li{margin-bottom:14px}.elsewhere a{font:20px Georgia,serif}.column .side-note{font:italic 13px/1.5 Georgia,serif;color:#596c60;margin-top:28px}
  .papers-panel{background:#fffffff0;padding:35px 32px 55px}.papers-head{display:flex;justify-content:space-between;gap:25px;align-items:end;border-bottom:2px solid var(--accent);padding-bottom:18px}.papers-head .overline{color:#815a6e}.papers-head h2{font:400 clamp(30px,3.5vw,44px) Georgia,serif;color:#22382a;margin:8px 0 0}.papers-head p{font-size:13px;color:#596c60}.paper{display:grid;grid-template-columns:68px 1fr;gap:15px;padding:18px 0;border-bottom:1px solid #d9e5dc}.year{color:#9a4665;padding-top:4px}.paper h3{font:400 19px/1.3 Georgia,serif;margin:0 0 5px}.paper p{font-size:12px;color:#455c4c;margin:0 0 5px;line-height:1.5}.paper small{color:#596c60;font-size:11px}.paper .venue-link{color:inherit}
  .talks-panel{background:#fffffff0;padding:35px 32px 55px;border-top:1px solid #d9e5dc}.talk{display:grid;grid-template-columns:125px 1fr;gap:15px;padding:17px 0;border-bottom:1px solid #d9e5dc}.talk h3{font:400 18px/1.35 Georgia,serif;color:#22382a;margin:0 0 6px}.talk p{font-size:12px;color:#455c4c;line-height:1.5;margin:0 0 4px}.talk .talk-event{color:#596c60}.talk-event a{color:var(--accent);text-decoration:none}.talk-event a:hover{text-decoration:underline}footer{background:#183b29;color:#dbe9dd;font-size:12px}footer .shell{display:flex;justify-content:space-between;gap:20px;padding-top:24px;padding-bottom:24px}footer a{color:#d2efd8;text-decoration:none}
  @media(max-width:900px){.mast-title{margin-left:5%}.index-grid{gap:23px}.column + .column{padding-left:23px}.elsewhere a{font-size:18px}}
  @media(max-width:700px){.mast,.mast-inner{min-height:570px}.topline{align-items:flex-start;flex-wrap:wrap}.topline nav{gap:16px;flex-wrap:wrap}.mast-title{margin:115px 0 95px 0}.mast h1{font-size:clamp(47px,12vw,66px)}.index-panel{padding:23px 23px 34px}.panel-top span:last-child{display:none}.index-grid{display:block}.column + .column{padding:26px 0 0;border-left:0;border-top:1px solid #c9d9ce;margin-top:26px}.column h2{margin-bottom:16px}.papers-panel,.talks-panel{padding:29px 23px 43px}.papers-head{display:block}.paper{grid-template-columns:50px 1fr;gap:8px}.paper h3{font-size:17px}.talk{grid-template-columns:1fr;gap:4px}.talk h3{font-size:17px}.papers-head p{margin-bottom:0}}
</style>
