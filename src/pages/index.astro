---
import Base from '../layouts/Base.astro';
import { publications } from '../data/publications';
---
<Base title="Shunsuke Yasunaga | Website" description="Website of Shunsuke Yasunaga, a researcher in theoretical physics.">
  <header class="mast" id="top">
    <div class="mast-shade"></div>
    <div class="shell mast-inner">
      <div class="topline">
        <a class="name" href="#top">Shunsuke Yasunaga</a>
        <nav aria-label="Main navigation"><a href="#about">About</a><a href="#work">Work</a><a href="#papers">Papers</a><a href="#links">Links</a></nav>
      </div>
      <div class="chalk chalk-left" aria-hidden="true">S = ∫ d⁴x ℒ<br />T = V + T G₀ V<br />D₅ → D₄<br />∂<sub>μ</sub>J<sup>μ</sup> = 0<br />⟨O⟩ = 1/Z ∫ Dφ O e<sup>−S</sup></div>
      <div class="chalk chalk-right" aria-hidden="true">K⁻d → πΛN<br />ΛN ↔ ΣN<br />det D(m)<br />⟨ψ̄ψ⟩<br />E² = p² + m²</div>
      <div class="mast-title"><span class="overline">THEORETICAL PHYSICS · TOKYO</span><h1>Research notes<br /><span>&amp; other paths</span></h1><p>Questions about interacting particles, with calculations, models, and a few computational detours.</p></div>
      <svg class="sketch" viewBox="0 0 420 285" aria-hidden="true">
        <defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 L7 3.5 L0 7" fill="none" stroke="currentColor" /></marker></defs>
        <path d="M34 212 C122 214 114 119 200 123 S311 125 383 48" fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M31 213 C93 207 111 239 158 226 S249 189 314 230" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="5 6" />
        <circle cx="201" cy="123" r="29" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="201" cy="123" r="43" fill="none" stroke="currentColor" stroke-dasharray="3 6" />
        <circle cx="32" cy="212" r="4" fill="currentColor" /><circle cx="383" cy="48" r="4" fill="currentColor" />
        <text x="22" y="198">K⁻ d</text><text x="171" y="128">T(E)</text><text x="328" y="38">π Λ N</text><text x="265" y="260">threshold?</text>
      </svg>
      <div class="mast-bottom"><span>Institute of Science Tokyo</span><a href="#contents">Enter the page ↓</a></div>
    </div>
  </header>

  <main id="main" class="field">
    <div class="shell">
      <div class="index-panel" id="contents">
        <div class="panel-top"><span>INDEX / 01</span><span>Follow whichever thread looks interesting.</span></div>
        <div class="index-grid">
          <section id="about" class="column"><h2><span aria-hidden="true">✎</span> About</h2><p>I am a doctoral researcher in theoretical physics at the Institute of Science Tokyo. I work with scattering amplitudes and numerical approaches to the strong interaction.</p><p>My interests move between reactions, field theory, and computation; these are different ways of asking what a calculation can tell us about particles.</p><a href="https://orcid.org/0009-0004-7788-0074">ORCID ↗</a><br /><a href="https://inspirehep.net/authors/2789921">INSPIRE profile ↗</a></section>
          <section id="work" class="column"><h2><span aria-hidden="true">⌁</span> Work in progress</h2><ul class="index-links"><li><a href="https://arxiv.org/abs/2610.15928">A structure near the ΣN threshold ↗</a><small>reactions · 2026</small></li><li><a href="https://arxiv.org/abs/2603.16329">Tuning domain-wall fermions ↗</a><small>computation · 2026</small></li><li><a href="https://arxiv.org/abs/2605.00727">Hyperon–nucleon interactions ↗</a><small>proceedings · 2026</small></li></ul><div class="margin-note">ΛN ↔ ΣN<br /><span>same question,<br />another channel →</span></div></section>
          <section id="links" class="column"><h2><span aria-hidden="true">↗</span> Elsewhere</h2><ul class="elsewhere"><li><a href="#papers">Papers &amp; preprints</a></li><li><a href="https://inspirehep.net/authors/2789921">INSPIRE-HEP</a></li><li><a href="https://orcid.org/0009-0004-7788-0074">ORCID</a></li><li><a href="https://github.com/SalviaRosmarinus">Code on GitHub</a></li></ul><div class="mini-diagram" aria-hidden="true"><span>input</span><i></i><strong>?</strong><i></i><span>observable</span></div><p class="side-note">A small map of current work, rather than a comprehensive account.</p></section>
        </div>
      </div>

      <section class="papers-panel" id="papers"><div class="papers-head"><div><span class="overline">INDEX / 02</span><h2>Papers &amp; preprints</h2></div><p>Most recent first. Titles link to the papers.</p></div><div class="paper-list">{publications.map((paper) => <article class="paper"><span class="year">{paper.year}</span><div><h3><a href={paper.url}>{paper.title} <span aria-hidden="true">↗</span></a></h3><p>{paper.authors}</p><small>{paper.venue}{paper.status ? ` · ${paper.status}` : ''}{paper.doi && <> · <a href={paper.doi}>Journal</a></>}</small></div></article>)}</div></section>
    </div>
  </main>
  <footer><div class="shell"><span>Shunsuke Yasunaga · {new Date().getFullYear()}</span><a href="#top">Back to top ↑</a></div></footer>
</Base>

<style>
  .mast{position:relative;min-height:610px;background:#100e26 url('/field-lines.svg') center 42%/cover no-repeat;color:#fff;overflow:hidden}
  .mast-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,9,29,.71) 0%,rgba(15,13,36,.24) 53%,rgba(10,8,23,.36)),linear-gradient(0deg,rgba(10,6,24,.8),transparent 36%)}
  .mast-inner{position:relative;min-height:610px;display:flex;flex-direction:column}.topline{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:26px 0;border-bottom:1px solid #ffffff5c}.name{font:400 17px Georgia,serif;color:#fff;text-decoration:none;letter-spacing:.02em}.topline nav{display:flex;gap:25px}.topline nav a,.mast-bottom a{color:#fff;text-decoration:none;font-size:13px}.topline a:hover,.mast-bottom a:hover{text-decoration:underline;text-decoration-color:#ffb9c4}
  .mast-title{position:relative;z-index:2;margin:107px 0 85px 11%;max-width:500px}.overline,.panel-top,.year{font-size:11px;letter-spacing:.13em;text-transform:uppercase;font-weight:700}.mast-title .overline{color:#f5b7cc}.mast h1{font:400 clamp(48px,6vw,82px)/1.02 Georgia,serif;letter-spacing:-.052em;margin:17px 0}.mast h1 span{font-style:italic;color:#e5f5f5}.mast-title p{font-size:16px;line-height:1.55;max-width:425px;color:#f0ecf5}.chalk{position:absolute;font:17px/1.7 Georgia,serif;color:#e9f5ff9e;white-space:nowrap;pointer-events:none;text-shadow:0 0 15px #77d9ff}.chalk-left{left:3%;top:130px;transform:rotate(-4deg)}.chalk-right{right:4%;top:105px;text-align:right;transform:rotate(3deg)}.sketch{position:absolute;right:6%;bottom:88px;width:min(35%,390px);height:auto;color:#f5c6c6;opacity:.8;font:italic 15px Georgia,serif;filter:drop-shadow(0 0 6px #e763a0)}.mast-bottom{margin-top:auto;display:flex;justify-content:space-between;padding:19px 0;border-top:1px solid #ffffff66;color:#e5dde8;font-size:12px}
  .field{padding:0 0 100px;background-color:#e8e5ed;background-image:linear-gradient(#f5f3f1e3,#f5f3f1ef),url('/field-lines.svg');background-size:auto,cover;background-position:center top;background-attachment:scroll,fixed}.index-panel{position:relative;top:-22px;padding:26px 32px 38px;background:#fffefbea;box-shadow:0 16px 36px #19102736;border-top:5px solid #a91648}.panel-top{display:flex;justify-content:space-between;gap:20px;color:#675666;border-bottom:1px solid #cfbac2;padding:0 0 17px}.panel-top span:last-child{font-weight:400;letter-spacing:0;text-transform:none}.index-grid{display:grid;grid-template-columns:1.04fr 1.12fr .84fr;gap:35px;padding-top:27px}.column{min-width:0}.column + .column{border-left:1px solid #d2c7ca;padding-left:35px}.column h2{font:700 clamp(23px,2.3vw,30px)/1.15 Georgia,serif;color:#63204d;margin:0 0 25px}.column h2 span{font:normal 20px system-ui;color:#9d3859;margin-right:5px}.column p{font-size:15px;line-height:1.7;color:#29212c;margin:0 0 16px}.column a,.paper a{color:#9a1539;text-decoration:none}.column a:hover,.paper a:hover{text-decoration:underline}.index-links,.elsewhere{list-style:none;padding:0;margin:0}.index-links li{margin:0 0 20px}.index-links a{font:20px/1.25 Georgia,serif}.index-links small{display:block;color:#726271;font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-top:5px}.elsewhere li{margin-bottom:14px}.elsewhere a{font:20px Georgia,serif}.margin-note{font:24px Georgia,serif;color:#76415b;border-top:1px dashed #bda7ae;padding-top:17px;margin-top:29px;transform:rotate(-2deg);width:max-content;max-width:100%}.margin-note span{font:italic 14px/1.3 Georgia,serif;color:#8b5e6a}.mini-diagram{display:flex;align-items:center;gap:6px;color:#713752;font:italic 12px Georgia,serif;margin-top:45px}.mini-diagram i{width:18px;border-top:1px solid #713752}.mini-diagram strong{font-size:26px;border:1px solid #713752;border-radius:50%;width:42px;height:42px;display:grid;place-items:center}.column .side-note{font:italic 13px/1.5 Georgia,serif;color:#775d67;margin-top:22px}
  .papers-panel{background:#fffffff0;padding:35px 32px 55px}.papers-head{display:flex;justify-content:space-between;gap:25px;align-items:end;border-bottom:2px solid #6c2351;padding-bottom:18px}.papers-head .overline{color:#815a6e}.papers-head h2{font:400 clamp(30px,3.5vw,44px) Georgia,serif;color:#382439;margin:8px 0 0}.papers-head p{font-size:13px;color:#695a63}.paper{display:grid;grid-template-columns:68px 1fr;gap:15px;padding:18px 0;border-bottom:1px solid #e2d7db}.year{color:#9a4665;padding-top:4px}.paper h3{font:400 19px/1.3 Georgia,serif;margin:0 0 5px}.paper h3 span{font:15px system-ui}.paper p{font-size:12px;color:#554851;margin:0 0 5px;line-height:1.5}.paper small{color:#6d6270;font-size:11px}footer{background:#18122a;color:#d7cbd8;font-size:12px}footer .shell{display:flex;justify-content:space-between;gap:20px;padding-top:24px;padding-bottom:24px}footer a{color:#f4cad7;text-decoration:none}
  @media(max-width:900px){.mast-title{margin-left:5%}.chalk-left{left:0;opacity:.4}.chalk-right{right:0;opacity:.5}.sketch{width:33%;opacity:.5}.index-grid{gap:23px}.column + .column{padding-left:23px}.index-links a,.elsewhere a{font-size:18px}}
  @media(max-width:700px){.mast,.mast-inner{min-height:570px}.topline{align-items:flex-start;flex-wrap:wrap}.topline nav{gap:16px;flex-wrap:wrap}.mast-title{margin:115px 0 95px 0}.mast h1{font-size:clamp(47px,12vw,66px)}.mast-title p{max-width:330px}.chalk{font-size:13px}.chalk-left{top:130px;left:auto;right:10px;text-align:right;opacity:.36}.chalk-right{display:none}.sketch{width:180px;right:-38px;bottom:73px;opacity:.45}.index-panel{padding:23px 23px 34px}.panel-top span:last-child{display:none}.index-grid{display:block}.column + .column{padding:26px 0 0;border-left:0;border-top:1px solid #d2c7ca;margin-top:26px}.column h2{margin-bottom:16px}.margin-note{margin-top:18px}.mini-diagram{margin-top:26px}.papers-panel{padding:29px 23px 43px}.papers-head{display:block}.paper{grid-template-columns:50px 1fr;gap:8px}.paper h3{font-size:17px}.papers-head p{margin-bottom:0}}
</style>
